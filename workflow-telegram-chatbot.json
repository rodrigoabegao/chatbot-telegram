      "parameters": {
        "jsCode": "const cidade = $input.first().json.name\nconst temperatura = $input.first().json.main.temp\n\n// Arredondar apenas se necessário\nconst temperaturaFinal = Number.isInteger(temperatura)\n  ? temperatura\n  : Math.round(temperatura);\n\n// Criar string final\nconst mensagemFinal = `🌤️ A temperatura em ${cidade} é de ${temperaturaFinal}°C`;\n\nreturn [\n  {\n    json: {\n      cidade,\n      temperaturaOriginal: temperatura,\n      temperaturaArredondada: temperaturaFinal,\n      mensagem_final: mensagemFinal\n    }\n  }\n];\n"
      },
