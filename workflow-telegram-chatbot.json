    {
      "parameters": {
        "jsCode": "let texto = $json.cidade_formatada || \"\";\n\n// Remove acentos\nlet semAcento = texto\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\");\n\nreturn [\n  {\n    json: {\n      ...$json,\n      cidade_sem_acentos: semAcento\n    }\n  }\n];"
      },
