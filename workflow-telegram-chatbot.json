    {
      "parameters": {
        "jsCode": "let input = $input.first().json.queue|| \"\";\n\n// 1. Remove espaços extras\ninput = input.trim().replace(/\\s+/g, \" \");\n\n// 2. Remove apóstrofos (normal e tipográfico)\ninput = input.replace(/[’']/g, \"\");\n\n// 3. Remove espaços extras novamente (caso tenha criado espaços duplos)\ninput = input.trim().replace(/\\s+/g, \" \");\n\nlet cidade = \"\";\nlet estado = \"\";\nlet pais = \"BR\"; // padrão\n\n// 4. Se usar vírgula → prioriza formato oficial\nif (input.includes(\",\")) {\n\n    let partes = input.split(\",\").map(p => p.trim());\n\n    cidade = partes[0];\n\n    if (partes[1] && partes[1].length === 2) {\n        estado = partes[1].toUpperCase();\n    }\n\n    if (partes[2] && partes[2].length === 2) {\n        pais = partes[2].toUpperCase();\n    }\n\n} else {\n\n    let partes = input.split(\" \");\n\n    if (partes.length > 1 && /^[a-zA-Z]{2}$/.test(partes[partes.length - 1])) {\n        pais = partes.pop().toUpperCase();\n    }\n\n    if (partes.length > 1 && /^[a-zA-Z]{2}$/.test(partes[partes.length - 1])) {\n        estado = partes.pop().toUpperCase();\n    }\n\n    cidade = partes.join(\" \");\n}\n\n// 5. Ajusta capitalização mantendo acento\ncidade = cidade\n    .toLowerCase()\n    .split(\" \")\n    .map(p => p.charAt(0).toUpperCase() + p.slice(1))\n    .join(\" \");\n\n// 6. Monta query final\nlet queryFinal = estado \n    ? `${cidade},${estado},${pais}`\n    : `${cidade},${pais}`;\n\n// 7. Encode para URL\nlet queryEncoded = encodeURIComponent(queryFinal);\n\nreturn [\n  {\n    json: {\n      cidade_formatada: queryFinal,\n      cidade_url: queryEncoded\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
